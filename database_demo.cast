[3.978394, "o", "\u001b[?2004l\r\r\n"]
[4.009005, "o", "poetry run project\r\n"]
[4.546271, "o", "Добро пожаловать в модуль 'База данных'!\r\n\r\nВведите 'help' для просмотра доступных команд.\r\nВведите 'exit' для выхода из программы.\r\n"]
[4.546429, "o", "\r\n>>>Введите команду: "]
[5.991302, "o", "h"]
[6.174656, "o", "e"]
[6.409643, "o", "l"]
[6.66713, "o", "p"]
[7.041382, "o", "\r\n"]
[7.041821, "o", "\r\n***Процесс работы с таблицей***\r\nФункции:\r\n"]
[7.041853, "o", "<command> create_table <имя_таблицы> <столбец1:тип> .. - создать таблицу\r\n<command> list_tables - показать список всех таблиц\r\n<command> drop_table <имя_таблицы> - удалить таблицу\r\n\r\n***Операции с данными***\r\nФункции:\r\n"]
[7.041872, "o", "<command> insert into <имя_таблицы> values (<значение1>, <значение2>, ...) - создать запись\r\n<command> select from <имя_таблицы> where <столбец> = <значение> - прочитать записи по условию\r\n<command> select from <имя_таблицы> - прочитать все записи\r\n"]
[7.04189, "o", "<command> update <имя_таблицы> set <столбец1> = <новое_значение1> where <столбец_условия> = <значение_условия> - обновить запись.\r\n<command> delete from <имя_таблицы> where <столбец> = <значение> - удалить запись\r\n<command> info <имя_таблицы> - вывести информацию о таблице\r\n"]
[7.041907, "o", "\r\nОбщие команды:\r\n<command> exit - выход из программы\r\n<command> help - справочная информация\r\n"]
[7.041923, "o", "\r\n"]
[7.042665, "o", "\r\n>>>Введите команду: "]
[8.356581, "o", "create_table employees name:str department:str salary:int active:bool"]
[9.078162, "o", "\r\n"]
[9.07849, "o", "Таблица 'employees' успешно создана\r\n"]
[9.079549, "o", "\r\n>>>Введите команду: "]
[14.399794, "o", "list_tables"]
[14.97802, "o", "\r\n"]
[14.978555, "o", "Таблицы в базе данных:\r\n1. users\r\n"]
[14.978579, "o", "2. employees\r\n"]
[14.978982, "o", "\r\n>>>Введите команду: "]
[20.222122, "o", "info employees"]
[20.59149, "o", "\r\n"]
[20.593613, "o", "Файл метаданных 'data/employees.json' создан\r\nТаблица: employees\r\nСтолбцы: ID:int, name:str, department:str, salary:int, active:bool\r\nКоличество записей: 0\r\n"]
[20.59406, "o", "\r\n>>>Введите команду: "]
